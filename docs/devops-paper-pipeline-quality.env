# =============================================================================
# TestLadr — AI Paper Pipeline QUALITY settings (share with DevOps)
# Apply on paper-worker hosts. Restart worker after change.
# No secrets in this file — paste into existing .env / secrets manager.
# =============================================================================

# Quality floor (do not lower)
PAPER_SCORE_FLOOR=75

# Parallelism — keep o3 low to avoid timeouts/TPM failures
PAPER_GENERATE_CONCURRENCY=6
JEE_ADV_GENERATE_CONCURRENCY=6
PAPER_O3_CONCURRENCY=2
JEE_ADV_O3_CONCURRENCY=2
PAPER_EXPAND_CONCURRENCY=4
JEE_ADV_EXPAND_CONCURRENCY=4
PAPER_QUESTION_CONCURRENCY=6
JEE_ADV_QUESTION_CONCURRENCY=6

# Retries
PAPER_O3_SAME_SEAT_RETRIES=2
JEE_ADV_O3_SAME_SEAT_RETRIES=2
PAPER_VERIFY_TIMEOUT_RETRIES=2
JEE_ADV_VERIFY_TIMEOUT_RETRIES=2
PAPER_GEMINI_JSON_ATTEMPTS=4
JEE_ADV_GEMINI_JSON_ATTEMPTS=4

# Replacement budget & answer lock
PAPER_QUALITY_REPLACE_MAX=100
JEE_ADV_QUALITY_REPLACE_MAX=100
PAPER_TIER1_REKEY_ENABLED=1
AI_QB_STAGE_A_ANSWER_LOCK=1

# Independent solver (o3) — HIGH effort for correct key + explanation
PAPER_SOLVER_MODEL=o3
PAPER_SOLVER_REASONING_EFFORT=high
PAPER_SOLVER_TIMEOUT_MS=300000
PAPER_SOLVER_MAX_TOKENS=16000

# Verify path (already high)
OPENAI_VERIFY_MODEL=gpt-5.6-luna
OPENAI_VERIFY_REASONING_EFFORT=high
OPENAI_VERIFY_TIMEOUT_MS=180000
OPENAI_VERIFY_MAX_TOKENS=16000

# Legacy / other OpenAI reasoning default
OPENAI_REASONING_EFFORT=high

# Strict correctness (bank / dual-solver paths)
AI_QB_SOLVER_TRUTH=1
AI_QB_STRICT_ANSWER_CORRECTNESS=1
AI_QB_STRICT_ANSWER_CONFIDENCE_FLOOR=0.9
AI_QB_STAGE_A_REQUIRE_DOUBLE_AGREE=1

# Worker
PAPER_JOB_RUNNER=worker
PAPER_WORKER_AUTO_REQUEUE=0
AI_QB_GENERATION_JOB_TTL_MS=21600000

# Expected impact: higher accuracy / fewer wrong keys & weak explanations;
# slower + higher OpenAI cost per question. Restart: pnpm run worker:paper
